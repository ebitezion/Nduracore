APP_NAME=nduracore
APP_VERSION=1.0.0
PORT=4000
MY_ENV=development
DB_DSN=postgres://postgres:postgres@localhost:5432/nduracore?sslmode=disable
# Optional secret file support for vault/kms mounts:
# DB_DSN_FILE=/var/run/secrets/db_dsn
# Optional secret reference support:
# DB_DSN_REF=env:STAGING_DB_DSN

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_MAX_IDLE_TIME=15m

TOKEN_SECRET=change-me
# TOKEN_SECRET_FILE=/var/run/secrets/token_secret
# TOKEN_SECRET_REF=env:STAGING_TOKEN_SECRET
TOKEN_ISSUER=nduracore
TOKEN_AUDIENCE=nduracore-clients
TOKEN_TTL=24h

CORS_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10
AUTH_RATE_LIMIT_RPS=1
AUTH_RATE_LIMIT_BURST=3
# TRUSTED_PROXIES accepts CSV of IPs/CIDRs that can set X-Forwarded-For/X-Real-IP:
# TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16

# Redis-backed shared infra (optional; leave empty to use in-memory backends)
REDIS_ADDR=
REDIS_PASSWORD=
# REDIS_PASSWORD_FILE=/var/run/secrets/redis_password
# REDIS_PASSWORD_REF=env:STAGING_REDIS_PASSWORD
REDIS_DB=0
REDIS_QUEUE_KEY=nduracore:jobs

# OpenTelemetry tracing (optional)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SAMPLE_RATIO=1.0

# Phase 2 wallet backend (Alchemy network configuration)
ALCHEMY_NETWORK=eth-sepolia
ALCHEMY_ENABLE_LIVE_DEPOSITS=false
ALCHEMY_ENABLE_LIVE_BROADCASTS=false
ALCHEMY_CONFIRMATIONS_REQUIRED=12
# ALCHEMY_API_KEY=your-api-key
# ALCHEMY_API_KEY_FILE=/var/run/secrets/alchemy_api_key
# ALCHEMY_API_KEY_REF=env:STAGING_ALCHEMY_API_KEY
# Optional explicit RPC URL override (if empty, built from network + API key):
# ALCHEMY_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<api-key>
# Optional multi-network RPC overrides (JSON map):
# ALCHEMY_RPC_URLS_JSON={"eth-mainnet":"https://eth-mainnet.g.alchemy.com/v2/<key>","eth-sepolia":"https://eth-sepolia.g.alchemy.com/v2/<key>"}
# Optional multi-network API keys (JSON map). Used only when matching RPC URL is not set:
# ALCHEMY_API_KEYS_JSON={"eth-mainnet":"<mainnet-key>","eth-sepolia":"<sepolia-key>"}
# Optional signing key(s) for live on-chain broadcasts:
# ALCHEMY_PRIVATE_KEY=your-private-key-hex
# ALCHEMY_PRIVATE_KEYS_JSON={"eth-mainnet":"<private-key-hex>","eth-sepolia":"<private-key-hex>"}
# Optional vault-scoped signer key map (vault_id:network -> private-key):
# ALCHEMY_VAULT_PRIVATE_KEYS_JSON={"<vault-uuid>:eth-sepolia":"<private-key-hex>","<vault-uuid>:solana-devnet":"<base58-secret>"}
# Non-EVM key formats (live families):
# - solana-*  => base58 secret key (or keygen JSON array)
# - stellar-* => secret seed (S...)
# - xrpl-*    => seed (s...)
# - tron-*    => secp256k1 private key hex (with or without 0x)
# - aptos-*   => ed25519 private key hex (32-byte seed or 64-byte key)
# - sui-*     => suiprivkey... secret or ed25519 private key hex
# Optional ERC20 token contracts by network+asset for live transfers:
# Format is flat key map: "network:ASSET" => "0xContractAddress"
# ALCHEMY_ERC20_CONTRACTS_JSON={"eth-mainnet:USDC":"0xA0b86991c6218b36c1d19d4a2e9eb0ce3606eb48","eth-sepolia:USDC":"0x1c7d4b196cb0c7b01d743fbc6116a902379c7238"}
# ALCHEMY_WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret
# ALCHEMY_WEBHOOK_SIGNING_SECRET_FILE=/var/run/secrets/alchemy_webhook_secret
# ALCHEMY_WEBHOOK_SIGNING_SECRET_REF=env:STAGING_ALCHEMY_WEBHOOK_SECRET
