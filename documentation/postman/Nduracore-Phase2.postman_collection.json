{
  "info": {
    "name": "Nduracore Phase 2",
    "_postman_id": "7c4e0f1b-8df2-4d28-9d9e-9d9d00000001",
    "description": "Phase 2 custodial wallet MVP API flow: auth, wallets, deposits webhook, withdrawals, approvals.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Issue Token",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/auth/token",
          "host": ["{{base_url}}"],
          "path": ["v1", "auth", "token"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "if (json && json.auth && json.auth.token) {",
              "  pm.environment.set('bearer_token', json.auth.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Wallet - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{bearer_token}}" },
          { "key": "X-Tenant-ID", "value": "{{tenant_id}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"asset\": \"USDC\",\n  \"network\": \"eth-sepolia\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/wallets",
          "host": ["{{base_url}}"],
          "path": ["v1", "wallets"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "if (json && json.wallet && json.wallet.id) {",
              "  pm.environment.set('wallet_id', json.wallet.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Wallet - List",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{bearer_token}}" },
          { "key": "X-Tenant-ID", "value": "{{tenant_id}}" }
        ],
        "url": {
          "raw": "{{base_url}}/v1/wallets",
          "host": ["{{base_url}}"],
          "path": ["v1", "wallets"]
        }
      }
    },
    {
      "name": "Wallet - Get",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{bearer_token}}" },
          { "key": "X-Tenant-ID", "value": "{{tenant_id}}" }
        ],
        "url": {
          "raw": "{{base_url}}/v1/wallets/{{wallet_id}}",
          "host": ["{{base_url}}"],
          "path": ["v1", "wallets", "{{wallet_id}}"]
        }
      }
    },
    {
      "name": "Deposits - Webhook (Simple Payload)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Tenant-ID", "value": "{{tenant_id}}" },
          { "key": "X-Alchemy-Signature", "value": "{{alchemy_signature}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tx_hash\": \"0xabc123\",\n  \"amount_minor\": 250000,\n  \"confirmations\": 12,\n  \"status\": \"confirmed\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/wallets/{{wallet_id}}/deposits/webhook",
          "host": ["{{base_url}}"],
          "path": ["v1", "wallets", "{{wallet_id}}", "deposits", "webhook"]
        }
      }
    },
    {
      "name": "Deposits - List",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{bearer_token}}" },
          { "key": "X-Tenant-ID", "value": "{{tenant_id}}" }
        ],
        "url": {
          "raw": "{{base_url}}/v1/wallets/{{wallet_id}}/deposits",
          "host": ["{{base_url}}"],
          "path": ["v1", "wallets", "{{wallet_id}}", "deposits"]
        }
      }
    },
    {
      "name": "Withdrawals - Request",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{bearer_token}}" },
          { "key": "X-Tenant-ID", "value": "{{tenant_id}}" },
          { "key": "Idempotency-Key", "value": "{{idempotency_key}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"wallet_id\": \"{{wallet_id}}\",\n  \"destination\": \"{{approved_destination}}\",\n  \"amount_minor\": 100000\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/withdrawals",
          "host": ["{{base_url}}"],
          "path": ["v1", "withdrawals"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 202', function () { pm.response.to.have.status(202); });",
              "var json = pm.response.json();",
              "if (json && json.withdrawal && json.withdrawal.id) {",
              "  pm.environment.set('withdrawal_id', json.withdrawal.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Withdrawals - Get",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{bearer_token}}" },
          { "key": "X-Tenant-ID", "value": "{{tenant_id}}" }
        ],
        "url": {
          "raw": "{{base_url}}/v1/withdrawals/{{withdrawal_id}}",
          "host": ["{{base_url}}"],
          "path": ["v1", "withdrawals", "{{withdrawal_id}}"]
        }
      }
    },
    {
      "name": "Withdrawals - Approve",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{bearer_token}}" },
          { "key": "X-Tenant-ID", "value": "{{tenant_id}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"approved for payout\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/withdrawals/{{withdrawal_id}}/approve",
          "host": ["{{base_url}}"],
          "path": ["v1", "withdrawals", "{{withdrawal_id}}", "approve"]
        }
      }
    },
    {
      "name": "Withdrawals - Reject",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{bearer_token}}" },
          { "key": "X-Tenant-ID", "value": "{{tenant_id}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"manual rejection\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/withdrawals/{{withdrawal_id}}/reject",
          "host": ["{{base_url}}"],
          "path": ["v1", "withdrawals", "{{withdrawal_id}}", "reject"]
        }
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:4000" },
    { "key": "tenant_id", "value": "tenant-1" },
    { "key": "admin_email", "value": "admin@vein.dev" },
    { "key": "admin_password", "value": "VeinPass#2026!" },
    { "key": "bearer_token", "value": "" },
    { "key": "wallet_id", "value": "" },
    { "key": "withdrawal_id", "value": "" },
    { "key": "approved_destination", "value": "0x1111111111111111111111111111111111111111" },
    { "key": "idempotency_key", "value": "withdrawal-req-001" },
    { "key": "alchemy_signature", "value": "" }
  ]
}
